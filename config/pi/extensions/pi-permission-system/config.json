{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/refs/heads/main/packages/pi-permission-system/schemas/permissions.schema.json",

  "debugLog": false,
  "permissionReviewLog": false,
  "yoloMode": false,

  "forwardingTimeoutMs": 600000,
  "promptMaxRows": 24,
  "promptFieldMaxWidth": 400,
  "reviewLogFieldMaxWidth": 1000,

  "piInfrastructureReadPaths": [],
  "authorizerChain": [],

  "permission": {
    "*": "allow",

    "path": {
      "*": "allow",

      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",

      "~/.ssh/*": "deny",

      "~/.pi/agent/auth.json": "deny",
      "~/.pi/agent/models.json": "ask",
      "~/.pi/agent/pi-crd233.json": "deny"
    },

    "external_directory": {
      "*": "ask",

      "~/projects/*": "allow",
      "~/dev/*": "allow",
      "~/downloads/*": "allow",
      "~/Downloads/*": "allow",
      "/tmp/*": "allow",

      "~/.pi/agent/sessions/*": "allow",
      "~/.pi/agent/npm/*": "allow",
      "~/.pi/agent/git/*": "allow",

      "~/.cc-switch/skills/*": "allow",
      "~/.config/nvm/versions/node/*/lib/node_modules/*": "allow",
      "~/.vscode-server/extensions/*": "allow",
      "D:/NodeJS/npm_global/node_modules/*": "allow",
      "~/miniconda3/*": "allow"
    },

    "bash": {
      "*": "allow",

      "rm *": "ask",
      "rmdir *": "ask",
      "unlink *": "ask",
      "shred *": "ask",
      "truncate *": "ask",
      "find *-delete*": "ask",

      "del *": "ask",
      "erase *": "ask",
      "rd *": "ask",

      "cmd /c del *": "ask",
      "cmd /c erase *": "ask",
      "cmd /c rd *": "ask",
      "cmd /c rmdir *": "ask",

      "cmd.exe /c del *": "ask",
      "cmd.exe /c erase *": "ask",
      "cmd.exe /c rd *": "ask",
      "cmd.exe /c rmdir *": "ask",

      "Remove-Item *": "ask",
      "remove-item *": "ask",
      "Clear-Content *": "ask",
      "clear-content *": "ask",

      "powershell *Remove-Item*": "ask",
      "powershell *remove-item*": "ask",
      "powershell.exe *Remove-Item*": "ask",
      "powershell.exe *remove-item*": "ask",

      "pwsh *Remove-Item*": "ask",
      "pwsh *remove-item*": "ask",
      "pwsh.exe *Remove-Item*": "ask",
      "pwsh.exe *remove-item*": "ask",

      "git *clean *": "ask",
      "git *reset *--hard*": "ask",
      "git *checkout *-- *": "ask",
      "git *restore *": "ask",
      "git *branch -D *": "ask",
      "git *stash drop *": "ask",
      "git *stash clear *": "ask",

      "dropdb *": "ask",
      "mysql *": "ask",
      "mariadb *": "ask",
      "psql *": "ask",
      "sqlite3 *": "ask",
      "mongosh *": "ask",
      "redis-cli *": "ask",

      "docker *system prune*": "ask",
      "docker *volume prune*": "ask",
      "docker *volume rm *": "ask",
      "docker *rm *": "ask",

      "kubectl *delete *": "ask",
      "helm *uninstall *": "ask",
      "terraform *destroy*": "ask"
    }
  }
}
