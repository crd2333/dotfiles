{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/refs/heads/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": false,
  "yoloMode": false,

  "permission": {
    "*": "allow",

    "external_directory": {
      "*": "ask",

      "*\\users\\*\\.pi\\agent\\skills\\*": "allow",
      "*\\users\\*\\.pi\\agent\\npm\\*": "allow",
      "*\\users\\*\\.pi\\agent\\sessions\\*": "allow",
      "*\\users\\*\\.pi\\agent\\repos\\*": "allow",

      "~/.pi/agent/npm/*": "allow",
      "~/.pi/agent/git/*": "allow",
      "~/.pi/agent/sessions/*": "allow",

      "*\\dev\\null\\*": "allow",
      "*\\dev\\null*": "allow",
      "*\\dev\\null\\": "allow",
      "*\\dev\\null": "allow",

      "~/.config/nvm/versions/node/v24.16.0/lib/node_modules/@earendil-works/*": "allow",
      "D:\\NodeJS\\npm_global\\node_modules\\@earendil-works\\*": "allow",

      "~/downloads/*": "allow",
      "~/dev/*": "allow",
      "/tmp/*": "allow",
      "~/projects/*": "allow"
    },

    "path": {
      "*": "allow",

      "*.env": "deny",
      "*.env.*": "deny",
      "~/.ssh/*": "deny",
      "$HOME/.ssh/*": "deny",

      "*\\users\\*\\.pi\\agent\\auth.json": "deny",
      "*\\users\\*\\.pi\\agent\\models.json": "ask",
      "~/.pi/agent/auth.json": "deny",
      "~/.pi/agent/models.json": "ask",
      "~/.pi/agent/pi-crd233.json": "deny"
    },

    "bash": {
      "Remove-Item *": "ask",
      "remove-item *": "ask",
      "rm *": "ask",
      "del *": "ask",
      "erase *": "ask",
      "rd *": "ask",
      "rmdir *": "ask",
      "ri *": "ask",
      "mv *": "ask",

      "cmd /c del *": "ask",
      "cmd /c erase *": "ask",
      "cmd /c rd *": "ask",
      "cmd /c rmdir *": "ask",
      "cmd.exe /c del *": "ask",
      "cmd.exe /c erase *": "ask",
      "cmd.exe /c rd *": "ask",
      "cmd.exe /c rmdir *": "ask",

      "powershell *Remove-Item*": "ask",
      "powershell.exe *Remove-Item*": "ask",
      "pwsh *Remove-Item*": "ask",
      "pwsh.exe *Remove-Item*": "ask",

      "git clean *": "ask",
      "git reset --hard *": "ask",
      "git checkout -- *": "ask",
      "git restore *": "ask",

      "Clear-Content *": "ask",
      "Set-Content *": "ask",
      "Out-File *": "ask",
      "Move-Item *": "ask",
      "Rename-Item *": "ask"
    }
  }
}
