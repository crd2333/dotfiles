{
  "network": {
    "providers": [
      "deepseek",
      "tavily",
      "exa"
    ],
    "search": {
      "mode": "parallel"
    },
    "curator": {
      "model": "aio-ds/deepseek-v4.1-flash",
      "thinkingLevel": "low",
      "retryOnce": true
    },
    "fetch": {
      "order": [
        "deepseek",
        "tavily",
        "firecrawl",
        "smart",
        "direct"
      ]
    },
    "proxy": {
      "url": "http://127.0.0.1:19198",
      "hosts": [
        "github.com",
        "githubusercontent.com",
        "githubassets.com",
        "platform.openai.com",
        "platform.claude.com",
        "developers.openai.com",
        "docs.anthropic.com",
        "docs.claude.com",
        "ai.google.dev",
        "docs.x.ai",
        "docs.mistral.ai",
        "docs.cohere.com",
        "docs.perplexity.ai",
        "console.groq.com",
        "docs.together.ai",
        "docs.fireworks.ai",
        "docs.ollama.com",
        "ai-sdk.dev",
        "agentskills.io",
        "z.ai",
        "vllm.ai",
        "chatgpt.com",
        "claude.ai",
        "gemini.google.com",
        "aistudio.google.com",
        "perplexity.ai",
        "poe.com",
        "replicate.com",
        "openrouter.ai",
        "generativelanguage.googleapis.com",
        "aiplatform.googleapis.com",
        "huggingface.co",
        "hf.co",
        "youtube.com",
        "youtu.be",
        "youtube-nocookie.com",
        "googlevideo.com",
        "ytimg.com",
        "arxiv.org",
        "openreview.net",
        "nature.com",
        "tavily.com",
        "firecrawl.dev",
        "context7.com",
        "semanticscholar.org",
        "openalex.org",
        "cloudflare-dns.com"
      ]
    },
    "dns": {
      "mode": "doh",
      "doh": {
        "url": "https://cloudflare-dns.com/dns-query",
        "bootstrapAddresses": [
          "1.1.1.1",
          "1.0.0.1"
        ],
        "timeoutMs": 5000
      }
    },
    "tavily": {
      "searchDepth": "advanced",
      "answerDepth": "advanced",
      "extractDepth": "advanced",
      "searchChunksPerSource": 3
    }
  },
  "subagents": {
    "models": {
      "explore": [
        {
          "model": "aio-ds/deepseek-v4.1-flash",
          "thinkingLevel": "high"
        }
      ],
      "search": [
        {
          "model": "aio-ds/deepseek-v4.1-flash",
          "thinkingLevel": "high"
        }
      ],
      "check": [
        {
          "model": "aio-ds/deepseek-v4.1-flash",
          "thinkingLevel": "high"
        }
      ],
      "implement": [
        {
          "model": "aio-ds/deepseek-v4.1-flash",
          "thinkingLevel": "high"
        }
      ]
    },
    "maxTurns": {
      "explore": 30,
      "search": 30,
      "check": 40,
      "implement": 50
    },
    "maxBatch": 5,
    "maxParallel": 4,
    "inheritContext": {
      "explore": false,
      "search": false,
      "check": false,
      "implement": false
    }
  },
  "modelFix": {
    "rules": [
      {
        "match": {
          "modelIdRegex": "^gpt-5\\.6(?:-|$)"
        },
        "prompt": "gpt-5.6.md"
      },
      {
        "match": {
          "modelIdRegex": "^glm-5\\.3(?:-|$)"
        },
        "prompt": "glm-5.3.md"
      },
      {
        "match": {
          "modelIdRegex": "^deepseek-v4\\.1-flash(?:-|$)"
        },
        "prompt": "deepseek-v4.1-flash.md"
      },
      {
        "match": {
          "modelIdRegex": "^gpt-6-astra(?:-|$)"
        },
        "prompt": "gpt-6-astra.md"
      },
      {
        "match": {
          "modelIdRegex": "^gpt-6\\.1-sol(?:-|$)"
        },
        "prompt": "gpt-6.1-sol.md"
      }
    ]
  },
  "modelFilter": {
    "allow": [
      "openai/gpt-6.1-sol",
      "openai/gpt-6-*"
    ]
  }
}
